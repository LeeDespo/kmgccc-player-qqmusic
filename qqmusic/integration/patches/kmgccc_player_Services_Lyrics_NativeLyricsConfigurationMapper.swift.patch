+    /// The listener's translation preference, read from storage.
+    ///
+    /// Every surface this mapper seeds starts from it — including the fullscreen
+    /// surface, whose tree carries neither an `AppSettings` instance nor a settings
+    /// observer — and the control that flips it is the icon in the player's own
+    /// bars. `AppSettings.lyricsShowTranslation` is the same key.
+    static var storedShowsTranslation: Bool {
+        let defaults = UserDefaults.standard
+        guard defaults.object(forKey: "lyricsShowTranslation") != nil else { return true }
+        return defaults.bool(forKey: "lyricsShowTranslation")
+    }
+
+    /// Push the preference to the lyric surfaces that are up right now.
+    ///
+    /// Not waiting for the configuration to be rebuilt is the point: a rebuild
+    /// would need a reload or a track change, and the toggle is meant to act like
+    /// the lyrics-visibility button next to it.
+    @MainActor
+    static func applyTranslationVisibility(_ shows: Bool) {
+        for role in LyricsSurfaceRole.allCases {
+            guard var configuration = NativeLyricsSurfaceManager.shared.configuration(for: role) else {
+                continue
+            }
+            configuration.showTranslation = shows
+            NativeLyricsSurfaceManager.shared.applyConfiguration(configuration, for: role)
+        }
+    }
+

     }
 
+    /// The current track, when it is an online-sourced one that can be liked.
+    private func likeableTrack(_ presentation: NowPlayingPresentation) -> Track? {
+        guard presentation.source == .local,
+              let track = playerVM.currentTrack,
+              track.qqMusicSongMid?.isEmpty == false
+        else { return nil }
+        return track
+    }
+
+    /// Favorite toggle, styled to match the transport controls.
+    ///
+    /// The upstream applies the write asynchronously, so the optimistic state
+    /// flips immediately and reverts if the request is refused.
+    private func likeButton(for track: Track) -> some View {
+        let coordinator = qqMusicCoordinator
+        let isLiked = coordinator?.isLiked(track) ?? false
+        let isPending = coordinator?.isLikePending(track) ?? false
+        return Button {
+            guard let coordinator else { return }
+            Task { await coordinator.toggleLike(track) }
+        } label: {
+            Group {
+                if isPending {
+                    ProgressView()
+                        .controlSize(.small)
+                        .frame(width: 18, height: 18)
+                } else {
+                    Image(systemName: isLiked ? "heart.fill" : "heart")
+                        .font(.system(size: 15, weight: .medium))
+                        .foregroundStyle(isLiked ? themeStore.accentColor : controlPrimaryColor)
+                        .contentTransition(.symbolEffect(.replace))
+                }
+            }
+            .frame(width: 22, height: 22)
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .disabled(isPending)
+        .help(isLiked ? "取消收藏" : "收藏到「我喜欢」")
+        .animation(.snappy(duration: 0.2), value: isLiked)
+    }
+
     private func currentPlaybackMode(for presentation: NowPlayingPresentation) -> PlaybackOrderMode {
         presentation.localPlaybackOrderMode ?? settings.playbackOrderMode
     }

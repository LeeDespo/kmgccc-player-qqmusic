@@ -224,9 +227,57 @@ struct MiniPlayerView: View {
                 disabledColor: controlDisabledColor,
                 action: { playbackCoordinator.next() }
             )
+
+            // Favorite. Only shown for online-sourced tracks when enabled in
+            // QQ Music settings: a local file has no upstream id to write to.
+            if settings.qqMusicShowLikeButton, let track = likeableTrack(presentation) {
+                likeButton(for: track)

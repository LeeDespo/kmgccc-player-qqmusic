# GitHub Linguist - Exclude AMLL directories from language statistics
# Documentation: https://github.com/github/linguist/blob/master/docs/overrides.md

# AMLL runtime resources
kmgccc_player/Resources/AMLL/** linguist-vendored

# Retired vendor-source paths are no longer tracked by this fork.
# QQ Music runtime binaries come from the locked upstream release assets.

# Keep accidental private inputs out of source archives. The release audit
# still rejects these paths in clones and in reachable Git history.
BKThemes/** export-ignore
EncryptedArtAssets/** export-ignore
PrivateArtSources/** export-ignore
BKArt.bundle/** export-ignore
kmgccc_player/Resources/BKArt.bundle/** export-ignore
kmgccc_player/Rendering/BokehTransition/BokehTransitionShader.metal export-ignore
kmgccc_player/Rendering/BokehTransition/*.metallib export-ignore
scripts/encrypt_art_assets.swift export-ignore
scripts/encrypted_asset_allowlist.json export-ignore
